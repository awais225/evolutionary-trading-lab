# Hero1 — example environment configuration. Copy to .env and fill in YOUR values.
# .env is git-ignored. NEVER commit real credentials. No secrets belong in this file.

# DATA root — MUST be a directory OUTSIDE this Git repository.
# Production (Windows laptop, per project plan): D:\Hero1\DATA
# Development default (when unset): ~/.hero1/data  (outside the repo)
HERO1_DATA_ROOT=/absolute/path/outside/the/repository/DATA

# Ollama (local inference). Default endpoint — Ollama binds localhost by default.
HERO1_OLLAMA_HOST=http://127.0.0.1:11434
# Choose a model that fits YOUR GPU. Do not copy blindly — benchmark first (see docs/WINDOWS_SETUP.md).
HERO1_OLLAMA_MODEL=qwen2.5-coder:14b-instruct-q5_K_M
HERO1_OLLAMA_NUM_CTX=8192
HERO1_OLLAMA_TIMEOUT_S=60

# Logging: DEBUG | INFO | WARNING | ERROR
HERO1_LOG_LEVEL=INFO

# GitHub tokens/PATs are NOT configured here by design.
# If you want agent-driven git push tasks, add GITHUB_TOKEN through your
# platform's secure Secrets/Credentials interface — never into this file.
